#!/usr/bin/env bash
# pre-commit — lint rapide des fichiers staged (objectif < 10 s).
#
# Vérifications :
#   1) Ruff sur les .py staged
#   2) shellcheck sur les .sh staged
#   3) Détection naïve de secrets dans les diffs

set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=.githooks/_lib.sh
. "$SCRIPT_DIR/_lib.sh"

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT" || exit 1

mapfile -t STAGED < <(staged_files)
if [ "${#STAGED[@]}" -eq 0 ]; then
  echo "Aucun fichier staged — rien à linter."
  exit 0
fi

# ── 1) Ruff sur les .py staged ────────────────────────────────────────────
hook_title "Ruff (.py staged)"
mapfile -t PY_FILES < <(filter_ext py "${STAGED[@]}")
if [ "${#PY_FILES[@]}" -eq 0 ]; then
  hook_ok "aucun .py staged"
else
  RUFF="$(hook_ruff)"
  if [ -z "$RUFF" ]; then
    hook_skip "ruff non trouvé (pip install ruff)"
  else
    if "$RUFF" check "${PY_FILES[@]}"; then
      hook_ok "${#PY_FILES[@]} fichier(s) Python propres"
    else
      hook_fail "ruff a trouvé des problèmes (ruff check --fix <fichier>)"
    fi
  fi
fi

# ── 2) shellcheck sur les .sh staged ──────────────────────────────────────
hook_title "shellcheck (.sh staged)"
mapfile -t SH_FILES < <(filter_ext sh "${STAGED[@]}")
if [ "${#SH_FILES[@]}" -eq 0 ]; then
  hook_ok "aucun .sh staged"
elif ! hook_has shellcheck; then
  hook_skip "shellcheck non installé (sudo apt install shellcheck)"
else
  FAIL=0
  for f in "${SH_FILES[@]}"; do
    if ! shellcheck -x "$f"; then FAIL=1; fi
  done
  if [ "$FAIL" -eq 0 ]; then
    hook_ok "${#SH_FILES[@]} script(s) bash propres"
  else
    hook_fail "shellcheck a trouvé des problèmes"
  fi
fi

# ── 3) Détection naïve de secrets ─────────────────────────────────────────
hook_title "Détection de secrets"
# Valeurs littérales uniquement — les références de variables ($TOKEN, $VAR) ne sont pas des secrets.
SECRET_PATTERNS='BEGIN (RSA|EC|DSA|OPENSSH|PGP) PRIVATE KEY|AKIA[0-9A-Z]{16}|aws_secret_access_key\s*=\s*[A-Za-z0-9+/]{40}|password\s*=\s*"[^$][^\s"]{7,}"'
if git diff --cached -U0 -- "${STAGED[@]}" | grep -E "$SECRET_PATTERNS" >/dev/null 2>&1; then
  hook_fail "pattern de secret détecté — vérifier avant commit"
  git diff --cached -U0 -- "${STAGED[@]}" | grep -E "$SECRET_PATTERNS" || true
else
  hook_ok "aucun pattern de secret"
fi

hook_summary
